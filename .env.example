# Copy this file to .env; never commit your real API keys.
# This sample matches current code defaults. Default dual mode needs BOTH keys.

# Stage 1: OpenAI audio transcription. Stage 2: Groq text cleanup.
PROCESSING_MODE=dual
TRANSCRIPTION_MODEL=openai:gpt-transcribe
CLEANUP_MODEL=openai/gpt-oss-20b
PRIMARY_PROVIDER=groq

OPENAI_API_KEY=
GROQ_API_KEY=
# GEMINI_API_KEY=

# For OpenAI on both dual-mode stages, set:
# CLEANUP_MODEL=openai:gpt-4o-mini
#
# For a single OpenAI audio model, set:
# PROCESSING_MODE=mono
# MONO_MODEL=openai:gpt-audio-mini
#
# For Gemini, select gemini:your-model-id and set GEMINI_API_KEY.

LANGUAGES=Portuguese,English
HOTKEY=alt+\
SILENCE_THRESHOLD=1
# Silence creates a natural split; long continuous speech is cut at 12s.
# Dual mode repeats 0.8s of audio ONLY after a forced 12s split.
# Mono mode uses the same cap but no audio overlap.
SILENCE_DURATION=0.7
MIN_CHUNK_DURATION=3.0
MAX_CHUNK_DURATION=12.0
CHUNK_OVERLAP_DURATION=0.8

# Mono-only settings: scores control internal buffering; paste happens ONCE
# after processing, not immediately when the threshold is reached.
MONO_MODEL=openai:gpt-audio-mini
MONO_PASTE_THRESHOLD=0.90
MONO_CONTEXT_CHARS=500
MONO_TEMPERATURE=0.0
MONO_LOG_SCORES=false

# Optional: compatible style rules are added to mandatory cleanup rules.
# CLEANUP_SYSTEM_PROMPT=Keep the author's informal tone.

# Legacy raw-model transcription setting (not for prefixed models):
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
#
# SAFE_PASTE_TARGET is not a setting; paste targets the current focused field.

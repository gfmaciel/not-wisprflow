# ── Processing mode ───────────────────────────────────────────────────────────
# dual = transcription model first, cleanup model second (existing behavior)
# mono = one audio-capable OpenAI/Gemini model transcribes + cleans each chunk
PROCESSING_MODE=dual

# ── Model selection ───────────────────────────────────────────────────────────
# Recommended format: provider:model
# Supported providers: groq, openai, gemini
#
# Examples:
# TRANSCRIPTION_MODEL=openai:gpt-4o-mini-transcribe
# TRANSCRIPTION_MODEL=gemini:gemini-3.6-flash
# CLEANUP_MODEL=openai:gpt-5-mini
# CLEANUP_MODEL=gemini:gemini-3.6-flash
# MONO_MODEL=openai:gpt-audio-mini
# MONO_MODEL=gemini:gemini-3.6-flash
#
# Raw legacy values still work with PRIMARY_PROVIDER for backward compatibility.
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
CLEANUP_MODEL=openai/gpt-oss-20b
MONO_MODEL=openai:gpt-audio-mini

# ── Mono incremental behavior ─────────────────────────────────────────────────
# Mono returns cleaned current-chunk text + a semantic completion score (0..1).
# If score >= threshold, buffered text is pasted immediately. Otherwise it is
# held and a short trailing excerpt is sent as context with the next audio chunk.
MONO_PASTE_THRESHOLD=0.90
MONO_CONTEXT_CHARS=500
MONO_TEMPERATURE=0.0
# Set true while calibrating thresholds; logs score/paste decisions to console.
MONO_LOG_SCORES=false

# ── Legacy provider/fallback selection ────────────────────────────────────────
# Used only by dual-mode stages whose model does NOT explicitly select provider:model.
# The other OpenAI/Groq provider (if configured) acts as automatic fallback.
# Allowed values: groq (default), openai
PRIMARY_PROVIDER=groq

# ── API keys ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here
# OPENAI_API_KEY=your_openai_key_here
# GEMINI_API_KEY=your_gemini_key_here

# ── Legacy OpenAI fallback model settings ─────────────────────────────────────
# Kept for backward compatibility when PRIMARY_PROVIDER=openai or when OpenAI is fallback.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_CLEANUP_MODEL=gpt-4o-mini

# ── Other settings ────────────────────────────────────────────────────────────
LANGUAGES=Portuguese,English
HOTKEY=alt+\
SILENCE_THRESHOLD=1
SILENCE_DURATION=2.0
MIN_CHUNK_DURATION=3.0

CLEANUP_SYSTEM_PROMPT="You are a transcription cleanup assistant. Clean up the transcription by fixing punctuation, grammar, and capitalization, and removing filler words (uh, um, like, etc.). Do not rephrase, summarize, or add anything. Return only the cleaned text with no explanation.\n\nDetect the language of the input and respond in that same language."
